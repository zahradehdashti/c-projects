#include <stdio.h> 

int main()
{
    int marks[3];
    int total = 0;
    float average;
    int i;

    for (i=0; i<3; i++) 
    {
      printf("Enter score of student %d : ", i+1);
      scanf("%d", &marks[i]);
    }
    printf("------------------------------\n");
    for (i=0; i<3; i++) 
    {
      printf("Score of student %d : %d\n", i+1, marks[i]);
      total += marks[i];
    }
    printf("Total = %d\n", total);
    average = total / 3.0;
    printf("Average = %.2f\n", average);
  return 0;
}
